# =============================================================================
# SAL0MANder Web — environment example
# =============================================================================
# Copy to `.env.local` and fill in. NEVER commit real values.
#
# RULE: every variable exposed to the browser MUST be prefixed `VITE_`.
# Anything with a VITE_ prefix is PUBLIC — it ships inside the JS bundle.
# Secrets (service keys, DB URLs, signing keys, API secrets) must NEVER be
# given a VITE_ prefix and must never live in this app at all; they belong to
# a server/edge function in the future backend.
# =============================================================================

# --- Application identity -----------------------------------------------------
# Human-facing app name (branding may change; no UX is locked by this).
VITE_APP_NAME="SAL0MANder"

# Deployment environment: local | development | staging | production
VITE_APP_ENV="local"

# Public origin of this web app. Used to build share links for activities.
# e.g. https://play.sal0mander.example
VITE_PUBLIC_BASE_URL="http://localhost:5173"

# --- SAL0MANder API (cloud companion backend) ---------------------------------
# Base URL of the versioned SAL0MANder API. Leave empty to run the web app in
# fully offline/mock mode (the default for local foundation work).
VITE_API_BASE_URL=""

# Contract version this client speaks. Must match a folder in src/contracts/.
VITE_API_CONTRACT_VERSION="v1"

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS="15000"

# --- Unity WebGL host ---------------------------------------------------------
# Where the Unity WebGL build is served from. Empty = no build available yet;
# the WebGL host route renders a placeholder instead.
# Local example:  /unity
# CDN example:    https://cdn.example.com/unity/2026-08-15
VITE_UNITY_BUILD_BASE_URL=""

# Base filename Unity emits for its loader/data/framework/wasm files
# (Unity's "Build" name, e.g. `SAL0MANder`).
VITE_UNITY_BUILD_NAME="SAL0MANder"

# --- Storage / media ----------------------------------------------------------
# Which media storage provider the storage abstraction should use.
# memory  = in-browser, non-persistent (default for local dev)
# http    = upload via the SAL0MANder API (signed-URL flow), for later
VITE_STORAGE_PROVIDER="memory"

# Public CDN origin that serves stored media once uploaded.
VITE_MEDIA_CDN_BASE_URL=""

# --- Feature flags ------------------------------------------------------------
# Optional 42% Web Companion / 58% Unity split layout.
VITE_FEATURE_COMPANION_LAYOUT="true"

# Guest Play (no account required to open a shared activity link).
VITE_FEATURE_GUEST_PLAY="true"

# Accounts / profiles. Off until auth is chosen and approved.
VITE_FEATURE_ACCOUNTS="false"

# --- Observability ------------------------------------------------------------
# Public DSN / ingest key for client error reporting. Public by design.
# Left empty until a provider is chosen and approved.
VITE_TELEMETRY_DSN=""
VITE_TELEMETRY_SAMPLE_RATE="0.1"
