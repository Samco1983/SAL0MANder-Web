{
  "name": "sal0mander-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "checkin:monitor": "node scripts/sal0-checkin-monitor.mjs",
    "checkin:monitor:accept": "node scripts/sal0-checkin-monitor.mjs --accept",
    "checkin:override": "node scripts/sal0-checkin-monitor.mjs --override",
    "council:costs": "node scripts/sal0-council-costs.mjs",
    "council:dry-run": "node scripts/sal0-council-supervisor.mjs --dry-run",
    "council:execute": "node scripts/sal0-council-supervisor.mjs --run-agents --execute",
    "council:external-packet": "node scripts/sal0-external-packet.mjs",
    "council:launchd:plist": "node scripts/sal0-council-launchd.mjs",
    "council:print-packet": "node scripts/sal0-council-supervisor.mjs --print-packet",
    "council:roles:validate": "node scripts/sal0-roles-validate.mjs",
    "council:run-agents": "node scripts/sal0-council-supervisor.mjs --run-agents",
    "council:validate-schemas": "node scripts/sal0-council-supervisor.mjs --validate-schemas",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "make:payload:blockers": "node scripts/sal0-make-payload.mjs blocker-status",
    "make:payload:control-room": "node scripts/sal0-make-payload.mjs open-control-room",
    "make:payload:done": "node scripts/sal0-make-payload.mjs done-need-new-task",
    "make:payload:nudge": "node scripts/sal0-make-payload.mjs nudge-agents",
    "mission:bball": "python3 scripts/lib/sal0_bball_assistant.py",
    "mission:bball:json": "python3 scripts/lib/sal0_bball_assistant.py --json",
    "mission:bench": "python3 scripts/lib/sal0_autobench.py",
    "mission:bench:apply": "python3 scripts/lib/sal0_autobench.py --apply",
    "mission:blockers": "bash scripts/sal0-blocker-report.sh",
    "mission:control-room": "bash scripts/sal0-control-room.sh",
    "mission:desktop:install": "bash scripts/sal0-desktop-automation.sh install",
    "mission:desktop:logs": "bash scripts/sal0-desktop-automation.sh logs",
    "mission:desktop:pause": "bash scripts/sal0-desktop-automation.sh pause",
    "mission:desktop:resume": "bash scripts/sal0-desktop-automation.sh resume",
    "mission:desktop:run-once": "bash scripts/sal0-desktop-automation.sh run-once",
    "mission:desktop:status": "bash scripts/sal0-desktop-automation.sh status",
    "mission:desktop:uninstall": "bash scripts/sal0-desktop-automation.sh uninstall",
    "mission:next": "python3 scripts/lib/sal0_force_shot.py",
    "mission:next-task": "bash scripts/sal0-next-task.sh",
    "mission:next:json": "python3 scripts/lib/sal0_force_shot.py --json",
    "mission:preflight": "python3 scripts/sal0-mission-control-core.py",
    "mission:shots": "python3 scripts/lib/sal0_shot_queue.py",
    "mission:shots:json": "python3 scripts/lib/sal0_shot_queue.py --json",
    "mission:signals": "bash scripts/sal0-signal.sh --read",
    "mission:urls": "python3 scripts/sal0-mission-control-core.py --print-open-urls",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "description": "SAL0MANder cloud companion platform \u2014 web application.",
  "engines": {
    "node": ">=20.19"
  }
}
