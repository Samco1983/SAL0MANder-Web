{
  "name": "sal0mander-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "checkin:monitor": "node scripts/sal0-checkin-monitor.mjs",
    "checkin:override": "node scripts/sal0-checkin-monitor.mjs --override",
    "checkin:monitor:accept": "node scripts/sal0-checkin-monitor.mjs --accept",
    "council:dry-run": "node scripts/sal0-council-supervisor.mjs --dry-run",
    "council:launchd:plist": "node scripts/sal0-council-launchd.mjs",
    "council:run-agents": "node scripts/sal0-council-supervisor.mjs --run-agents",
    "council:validate-schemas": "node scripts/sal0-council-supervisor.mjs --validate-schemas"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "description": "SAL0MANder cloud companion platform — web application.",
  "engines": {
    "node": ">=20.19"
  }
}
