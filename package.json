{
  "name": "sal0mander-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "art:dry": "python3 scripts/lib/sal0_image_factory.py --all --dry-run",
    "art:list": "python3 scripts/lib/sal0_image_factory.py --list",
    "art:make": "python3 scripts/lib/sal0_image_factory.py",
    "build": "tsc -b && vite build",
    "build:pages": "VITE_BASE_PATH=/SAL0MANder-Web/ npm run build",
    "checkin:monitor": "node scripts/sal0-checkin-monitor.mjs",
    "checkin:monitor:accept": "node scripts/sal0-checkin-monitor.mjs --accept",
    "checkin:override": "node scripts/sal0-checkin-monitor.mjs --override",
    "claim": "python3 scripts/lib/sal0_claim.py",
    "council:costs": "node scripts/sal0-council-costs.mjs",
    "council:dry-run": "node scripts/sal0-council-supervisor.mjs --dry-run",
    "council:execute": "node scripts/sal0-council-supervisor.mjs --run-agents --execute",
    "council:external-packet": "node scripts/sal0-external-packet.mjs",
    "council:launchd:plist": "node scripts/sal0-council-launchd.mjs",
    "council:print-packet": "node scripts/sal0-council-supervisor.mjs --print-packet",
    "council:roles:validate": "node scripts/sal0-roles-validate.mjs",
    "council:run-agents": "node scripts/sal0-council-supervisor.mjs --run-agents",
    "council:validate-schemas": "node scripts/sal0-council-supervisor.mjs --validate-schemas",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "make:payload:blockers": "node scripts/sal0-make-payload.mjs blocker-status",
    "make:payload:control-room": "node scripts/sal0-make-payload.mjs open-control-room",
    "make:payload:done": "node scripts/sal0-make-payload.mjs done-need-new-task",
    "make:payload:nudge": "node scripts/sal0-make-payload.mjs nudge-agents",
    "mission:asset-scout": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/lib/sal0_asset_scout.py --validate",
    "mission:asset-scout:gemini": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/lib/sal0_asset_scout.py --nudge-gemini pet-classroom --json",
    "mission:asset-scout:mix": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/lib/sal0_asset_scout.py --production-mix",
    "mission:asset-scout:write-missing": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/lib/sal0_asset_scout.py --write-missing",
    "mission:backlog": "python3 scripts/lib/sal0_backlog_sync.py",
    "mission:backlog:apply": "python3 scripts/lib/sal0_backlog_sync.py --apply",
    "mission:bball": "python3 scripts/lib/sal0_bball_assistant.py",
    "mission:bball:json": "python3 scripts/lib/sal0_bball_assistant.py --json",
    "mission:bball:v3": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/lib/sal0_bball_v3.py",
    "mission:bball:v3:create": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/lib/sal0_bball_v3.py --create",
    "mission:bball:v3:json": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/lib/sal0_bball_v3.py --json",
    "mission:bench": "python3 scripts/lib/sal0_autobench.py",
    "mission:bench:apply": "python3 scripts/lib/sal0_autobench.py --apply",
    "mission:blockers": "bash scripts/sal0-blocker-report.sh",
    "mission:championship": "python3 scripts/lib/sal0_championship.py",
    "mission:championship:json": "python3 scripts/lib/sal0_championship.py --json",
    "mission:collision": "python3 scripts/lib/sal0_collision.py",
    "mission:collision:json": "python3 scripts/lib/sal0_collision.py --json",
    "mission:control-room": "bash scripts/sal0-control-room.sh",
    "mission:desktop:install": "bash scripts/sal0-desktop-automation.sh install",
    "mission:desktop:logs": "bash scripts/sal0-desktop-automation.sh logs",
    "mission:desktop:pause": "bash scripts/sal0-desktop-automation.sh pause",
    "mission:desktop:resume": "bash scripts/sal0-desktop-automation.sh resume",
    "mission:desktop:run-once": "bash scripts/sal0-desktop-automation.sh run-once",
    "mission:desktop:status": "bash scripts/sal0-desktop-automation.sh status",
    "mission:desktop:uninstall": "bash scripts/sal0-desktop-automation.sh uninstall",
    "mission:fit": "python3 scripts/lib/sal0_fit.py",
    "mission:fit:json": "python3 scripts/lib/sal0_fit.py --json",
    "mission:inbox": "sed -n '1,180p' docs/coordination/INBOX.md",
    "mission:next": "python3 scripts/lib/sal0_force_shot.py",
    "mission:next-task": "bash scripts/sal0-next-task.sh",
    "mission:next:json": "python3 scripts/lib/sal0_force_shot.py --json",
    "mission:nudge": "python3 scripts/sal0_nudge.py",
    "mission:nudge:dry": "python3 scripts/sal0_nudge.py --dry-run --max-cycles 1",
    "mission:packet": "python3 scripts/lib/sal0_court_packet.py",
    "mission:packet:json": "python3 scripts/lib/sal0_court_packet.py --json",
    "mission:points": "python3 scripts/lib/sal0_verify_points.py",
    "mission:points:json": "python3 scripts/lib/sal0_verify_points.py --json",
    "mission:pr-gate": "node scripts/sal0-pr-gate.mjs",
    "mission:pr-gate:json": "node scripts/sal0-pr-gate.mjs --json",
    "mission:preflight": "python3 scripts/sal0-mission-control-core.py",
    "mission:rebounder": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/lib/sal0_data_rebounder.py",
    "mission:rebounder:json": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/lib/sal0_data_rebounder.py --json",
    "mission:rotation": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/lib/sal0_rotation_coach.py",
    "mission:rotation:apply": "python3 scripts/lib/sal0_rotation_apply.py --apply",
    "mission:rotation:dry": "python3 scripts/lib/sal0_rotation_apply.py",
    "mission:rotation:json": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/lib/sal0_rotation_coach.py --json",
    "mission:shots": "python3 scripts/lib/sal0_shot_queue.py",
    "mission:shots:json": "python3 scripts/lib/sal0_shot_queue.py --json",
    "mission:signals": "bash scripts/sal0-signal.sh --read",
    "mission:urls": "python3 scripts/sal0-mission-control-core.py --print-open-urls",
    "owner": "python3 scripts/lib/sal0_owner_needed.py --always",
    "pages:fallback": "cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mission": "PYTHONDONTWRITEBYTECODE=1 python3 -W error::ResourceWarning -m unittest discover -s scripts/lib -p '*_test.py'",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:mission && npm run build",
    "verify:artifact": "node scripts/verify-deploy-artifact.mjs dist /SAL0MANder-Web/",
    "verify:deployed": "node scripts/verify-deployed-site.mjs",
    "verify:pages": "npm run build:pages && npm run pages:fallback && npm run verify:artifact",
    "mission:buttons": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/sal0-desk-buttons.py"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "jose": "^6.2.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "description": "SAL0MANder cloud companion platform — web application.",
  "engines": {
    "node": ">=24"
  }
}
