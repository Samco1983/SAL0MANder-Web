# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment (never commit real values; .env.example is the committed template)
.env
.env.*
!.env.example

# Test / build artifacts
coverage
.vite
*.tsbuildinfo

# Unity WebGL builds are large binary artifacts — served from CDN, not git
public/unity/

# Local coordination monitor state
docs/coordination/.checkin-monitor-state.json

# Mission Control run lock (local runtime state, never committed)
docs/coordination/.mission-control.lock
docs/coordination/.work-loop.lock

# Ephemeral: regenerated every run from the issue queue
docs/coordination/ops/CURRENT-TASK.md

docs/coordination/ops/SEASON.jsonl
.nudge.lock
NUDGES.jsonl

# Generated Python bytecode. Untracked build output that made the work loop
# refuse to start — it checks for a dirty tree, and a .pyc directory reads the
# same as an unfinished shot. Deleted by hand twice in one night before anyone
# noticed it was blocking every scheduled possession.
__pycache__/
*.py[cod]

# Generated art. Never committed: the manifests are prompts-only by rule,
# binary art in git history is unremovable, and the rights question is not
# settled. Provenance lives in a .json beside each image.
generated-art/
PROMPTS.txt

# Generated at deploy time from wrangler.example.toml, and locally by anyone
# deploying an edge Worker by hand. It carries environment-specific values —
# the Cloudflare Access team domain, the policy audience, owner emails — that
# have no business in a public repository. The .example file stays committed as
# the single description of the Worker's shape.
edge/**/wrangler.toml
