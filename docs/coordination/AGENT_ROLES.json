{
  "schemaVersion": "sal0-agent-roles-v0",
  "controlLayer": {
    "id": "mission-control-core",
    "displayName": "Mission Control Core — Python Supervisor",
    "isAgent": false,
    "role": "Local coordinator/orchestrator",
    "rules": [
      "Coordinate agents by SAL0 role id, not by vendor or model name.",
      "Build context packets from durable state before invoking any agent.",
      "Check hashes and skip repeated successful runs before model calls.",
      "Enforce timeouts, retries, schemas, logs, and evidence paths.",
      "Never make product or technical judgments itself.",
      "Never store secrets, tokens, cookies, or auth files."
    ]
  },
  "defaultStopRules": [
    "no-material-change",
    "task-complete-and-verified",
    "schema-validation-failed",
    "agent-unauthenticated",
    "required-state-unverified",
    "owner-decision-required",
    "retry-time-or-cost-limit-hit",
    "unresolved-material-disagreement"
  ],
  "agents": [
    {
      "id": "codex",
      "number": "SAL0-01",
      "codename": "Architect",
      "surfaceLabel": "Codex Desktop",
      "displayName": "SAL0-01 Architect — Codex Desktop",
      "clearRole": "Technical Lead",
      "authority": "technical-point-person",
      "primaryLane": "Unity/Game",
      "surfaces": ["desktop-chat", "cli"],
      "sessionPolicy": "stateless-by-default; resume only for explicit consultation",
      "callWhen": [
        "unity-game-engineering",
        "technical-architecture",
        "test-strategy",
        "automation-supervisor",
        "technical-reconciliation"
      ],
      "outputSchema": "sal0-council-decision-v0 or implementation evidence",
      "allowedActions": [
        "read-approved-project-files",
        "edit-assigned-repo",
        "run-tests",
        "commit-on-topic-changes",
        "push-approved-branches",
        "write-coordination-evidence"
      ],
      "forbiddenActions": [
        "touch-secrets",
        "destructive-git-without-owner-approval",
        "merge-human-acceptance-branches-without-owner-approval",
        "cross-lane-implementation-without-boundary-review"
      ],
      "failsafes": [
        "verify-folder-before-edit",
        "check-git-status-before-edit",
        "rerun-tests-after-change",
        "stop-on-unowned-dirty-files",
        "write-evidence-or-blocker"
      ]
    },
    {
      "id": "codex-cli",
      "number": "SAL0-02",
      "codename": "Runner",
      "surfaceLabel": "Codex CLI",
      "displayName": "SAL0-02 Runner — Codex CLI",
      "clearRole": "Local Execution",
      "authority": "local-execution-worker",
      "primaryLane": "Coordination",
      "surfaces": ["cli"],
      "sessionPolicy": "stateless worker; receives task-specific packets only",
      "callWhen": [
        "repo-status-check",
        "test-run",
        "diff-summary",
        "bounded-command-line-investigation",
        "stateless-technical-task"
      ],
      "outputSchema": "command output, implementation evidence, or blocker",
      "allowedActions": [
        "read-approved-project-files",
        "run-approved-commands",
        "run-tests",
        "summarize-diffs",
        "write-run-evidence"
      ],
      "forbiddenActions": [
        "touch-secrets",
        "destructive-git-without-owner-approval",
        "persist-hidden-memory",
        "claim-desktop-chat-context"
      ],
      "failsafes": [
        "stateless-packet-required",
        "exit-code-required",
        "stdout-stderr-captured",
        "timeout-required"
      ]
    },
    {
      "id": "chatgpt-openai",
      "number": "SAL0-03",
      "codename": "Director",
      "surfaceLabel": "OpenAI API",
      "displayName": "SAL0-03 Director — OpenAI API",
      "clearRole": "Product Decision",
      "authority": "program-product-manager",
      "primaryLane": "Coordination",
      "surfaces": ["desktop-chat", "api"],
      "sessionPolicy": "product-context packet first; do not rely on hidden memory",
      "callWhen": [
        "priority-decision",
        "acceptance-criteria",
        "product-reconciliation",
        "owner-facing-summary",
        "one-next-action-decision"
      ],
      "outputSchema": "sal0-council-decision-v0",
      "allowedActions": [
        "synthesize-agent-positions",
        "select-one-falsifiable-next-action",
        "request-owner-decision-when-required"
      ],
      "forbiddenActions": [
        "claim-test-evidence-without-run-data",
        "override-technical-feasibility-without-evidence",
        "promote-agent-opinion-to-decision-without-source"
      ],
      "failsafes": [
        "exactly-one-next-action",
        "owner-needed-yes-no",
        "source-pointer-required"
      ]
    },
    {
      "id": "claude",
      "number": "SAL0-04",
      "codename": "Builder",
      "surfaceLabel": "Claude CLI",
      "displayName": "SAL0-04 Builder — Claude CLI",
      "clearRole": "Web/Code Work",
      "authority": "web-code-lead-and-adversarial-reviewer",
      "primaryLane": "Web",
      "surfaces": ["cli", "browser-chat"],
      "sessionPolicy": "CLI preferred for evidence; browser chat is consult-only unless output is copied into a run",
      "callWhen": [
        "web-ux-review",
        "accessibility-review",
        "front-end-code-review",
        "architecture-overreach-check",
        "first-position-in-council-run"
      ],
      "outputSchema": "sal0-council-position-v0",
      "allowedActions": [
        "read-web-repo",
        "edit-web-repo-when-assigned",
        "produce-position",
        "run-web-tests",
        "write-web-evidence"
      ],
      "forbiddenActions": [
        "edit-unity-game-repo",
        "decide-cross-lane-seam-alone",
        "touch-secrets",
        "claim-private-github-state-without-access"
      ],
      "failsafes": [
        "if-cli-missing-write-blocker",
        "if-github-private-access-missing-label-unverified",
        "schema-validate-position",
        "no-vague-working-state"
      ]
    },
    {
      "id": "claude-chat",
      "number": "SAL0-05",
      "codename": "Reviewer",
      "surfaceLabel": "Claude Chat",
      "displayName": "SAL0-05 Reviewer — Claude Chat",
      "clearRole": "Manual Critique",
      "authority": "manual-adversarial-reviewer",
      "primaryLane": "Web",
      "surfaces": ["browser-chat"],
      "sessionPolicy": "manual consult only unless copied into run evidence",
      "callWhen": [
        "manual-ux-review",
        "accessibility-pushback",
        "architecture-overreach-review",
        "copy-paste-review"
      ],
      "outputSchema": "manual review copied into run evidence",
      "allowedActions": [
        "review-pasted-context",
        "produce-manual-critique",
        "raise-ux-or-accessibility-risk"
      ],
      "forbiddenActions": [
        "claim-cli-evidence",
        "edit-repos-directly",
        "touch-secrets",
        "be-treated-as-automation-identity"
      ],
      "failsafes": [
        "manual-output-must-be-copied-into-evidence",
        "label-as-manual-review",
        "no-vague-approval"
      ]
    },
    {
      "id": "gemini",
      "number": "SAL0-06",
      "codename": "Scout",
      "surfaceLabel": "Gemini Chat",
      "displayName": "SAL0-06 Scout — Gemini Chat",
      "clearRole": "Google/Browser Review",
      "authority": "google-cloud-browser-security-challenger",
      "primaryLane": "Coordination",
      "surfaces": ["browser-chat", "cli-or-api-later"],
      "sessionPolicy": "browser Gemini is manual/live-observer; CLI/API must be proven before unattended use",
      "callWhen": [
        "google-drive-or-google-cloud-design",
        "browser-behavior-review",
        "security-privacy-scaling-challenge",
        "critique-claude-position"
      ],
      "outputSchema": "sal0-council-critique-v0",
      "allowedActions": [
        "critique-specific-claude-claim",
        "raise-google-cloud-risk",
        "review-oauth-or-storage-plan",
        "produce-manual-copy-paste-advice"
      ],
      "forbiddenActions": [
        "generic-praise",
        "fourth-independent-answer-without-claim-reference",
        "claim-private-github-access-unless-proven",
        "edit-repos-without-explicit-assignment"
      ],
      "failsafes": [
        "must-reference-claude-claim-id",
        "must-quote-challenged-claim",
        "manual-chat-output-must-be-copied-into-run-evidence",
        "unknown-if-no-cli-or-api-proof"
      ]
    },
    {
      "id": "gemini-api-cli",
      "number": "SAL0-07",
      "codename": "Challenger",
      "surfaceLabel": "Gemini API/CLI",
      "displayName": "SAL0-07 Challenger — Gemini API/CLI",
      "clearRole": "Automated Critique",
      "authority": "automated-google-cloud-security-challenger",
      "primaryLane": "Coordination",
      "surfaces": ["api", "cli"],
      "sessionPolicy": "future unattended critique worker; must be proven before activation",
      "callWhen": [
        "automated-critique",
        "google-cloud-security-risk",
        "oauth-storage-risk",
        "critique-claude-position"
      ],
      "outputSchema": "sal0-council-critique-v0",
      "allowedActions": [
        "critique-specific-claude-claim",
        "cite-challenged-claim",
        "raise-security-or-scaling-risk"
      ],
      "forbiddenActions": [
        "generic-praise",
        "independent-answer-without-claim-reference",
        "edit-repos-directly",
        "claim-private-github-access-unless-proven"
      ],
      "failsafes": [
        "must-reference-claude-claim-id",
        "must-quote-challenged-claim",
        "schema-validate-critique",
        "fail-if-cli-or-api-unproven"
      ]
    },
    {
      "id": "unity-ai",
      "number": "SAL0-08",
      "codename": "Inspector",
      "surfaceLabel": "Unity MCP",
      "displayName": "SAL0-08 Inspector — Unity MCP",
      "clearRole": "Unity Evidence",
      "authority": "unity-editor-specialist",
      "primaryLane": "Unity/Game",
      "surfaces": ["unity-editor", "mcp"],
      "sessionPolicy": "evidence tool only unless Codex assigns bounded Unity work",
      "callWhen": [
        "rendered-screenshot-needed",
        "play-mode-evidence-needed",
        "scene-or-editor-state-needed",
        "unity-layout-inspection"
      ],
      "outputSchema": "rendered/editor evidence or exact blocker",
      "allowedActions": [
        "run-play-mode-verification",
        "capture-editor-evidence",
        "inspect-scene-state",
        "report-console-state"
      ],
      "forbiddenActions": [
        "mutate-gameplay-without-codex-assignment",
        "change-protected-p0-loop",
        "touch-web-repo",
        "claim-visual-acceptance-for-samuel"
      ],
      "failsafes": [
        "stop-on-playmode-failure",
        "report-console-errors",
        "label-screenshot-resolution",
        "do-not-merge"
      ]
    },
    {
      "id": "make",
      "number": "SAL0-09",
      "codename": "Signal",
      "surfaceLabel": "Make Cloud",
      "displayName": "SAL0-09 Signal — Make Cloud",
      "clearRole": "Outside Automation",
      "authority": "outside-edge-automation",
      "primaryLane": "Make Automation",
      "surfaces": ["webhooks", "dashboard"],
      "sessionPolicy": "no hidden reasoning; every run needs an id and visible effect",
      "callWhen": [
        "off-hours-webhook",
        "notification",
        "google-docs-mirror",
        "third-party-saas-edge"
      ],
      "outputSchema": "run id plus visible effect",
      "allowedActions": [
        "receive-webhook",
        "send-notification",
        "write-google-docs-mirror-when-approved",
        "record-run-id"
      ],
      "forbiddenActions": [
        "act-as-core-orchestrator",
        "store-secrets-in-repo",
        "change-live-scenario-without-confirmation",
        "claim-agent-wakeup-without-dispatch-claim-result-evidence"
      ],
      "failsafes": [
        "dashboard-run-id-required",
        "idempotency-key-required",
        "no-secret-proof-required",
        "manual-confirmation-before-live-scenario-change"
      ]
    },
    {
      "id": "github",
      "number": "SAL0-10",
      "codename": "Ledger",
      "surfaceLabel": "GitHub Cloud",
      "displayName": "SAL0-10 Ledger — GitHub Cloud",
      "clearRole": "Source Of Truth",
      "authority": "durable-evidence-hub",
      "primaryLane": "Coordination",
      "surfaces": ["cloud", "issues", "pull-requests", "commits"],
      "sessionPolicy": "durable evidence and audit trail, not model memory",
      "callWhen": [
        "record-evidence",
        "verify-commit",
        "open-or-review-pr",
        "read-accepted-project-truth"
      ],
      "outputSchema": "commit, issue, pull request, or comment reference",
      "allowedActions": [
        "store-commits",
        "store-issues",
        "store-pull-requests",
        "store-review-comments",
        "preserve-audit-trail"
      ],
      "forbiddenActions": [
        "replace-human-acceptance",
        "act-as-scheduler",
        "store-secrets-in-comments",
        "silently-promote-agent-opinions"
      ],
      "failsafes": [
        "source-pointer-required",
        "private-access-must-be-explicit",
        "no-secret-comments",
        "branch-before-merge"
      ]
    }
  ]
}
