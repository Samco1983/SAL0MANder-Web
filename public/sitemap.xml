<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static rather than generated: this site has a handful of public pages and a
  build step that emits a sitemap is a build step that can silently stop
  emitting one. Add a URL here when a public page is added.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://sal0mander.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <!--
    /demo is deliberately absent. The activity gallery is not merged to main
    yet, and the SPA fallback serves index.html for unknown paths — so a
    crawler following it would get the not-found screen rendered under a URL
    the sitemap vouched for. A sitemap that points at missing pages is worse
    for classification than a short one. Add it in the same change that ships
    the route.
  -->
  <url>
    <loc>https://sal0mander.com/about/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://sal0mander.com/privacy/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://sal0mander.com/terms/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
</urlset>
